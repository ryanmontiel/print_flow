{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintFlow",
  "mainBinaryName": "printflow",
  "version": "0.1.0",
  "identifier": "com.printflow.kiosk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4003",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build && npm run runtime:deps"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrintFlow Kiosk",
        "url": "http://127.0.0.1:4003",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "resources": {
      "../server-kiosk.js": "server-kiosk.js",
      "../dist": "dist",
      "../runtime/node_modules": "node_modules"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["nodejs"]
      }
    }
  }
}
