{
  "name": "printflow",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n front,back -c cyan,yellow \"vite\" \"node server.js\"",
    "build": "tsc && vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "dev:kiosk": "concurrently -n kiosk,back -c cyan,yellow \"cd kiosk && vite\" \"cd kiosk && node server-kiosk.js\"",
    "build:kiosk": "cd kiosk && npm run build",
    "start:kiosk": "cd kiosk && node server-kiosk.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "nodemailer": "^10.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
